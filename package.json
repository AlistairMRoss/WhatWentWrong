{
  "name": "whatwentwrong",
  "version": "0.3.0",
  "description": "Drop-in error alerting for SST v3 (ion) projects: SNS + CloudWatch alarms wired up with one .watch() call, with AI error analysis and email/Slack/Discord delivery.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alistairmross/whatwentwrong"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "import": "./dist/capture.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "lint": "eslint .",
    "prepublishOnly": "bun run lint && bun run build",
    "release": "npm version patch && npm publish --access public"
  },
  "keywords": [
    "sst",
    "ion",
    "pulumi",
    "aws",
    "cloudwatch",
    "sns",
    "alerting",
    "monitoring",
    "lambda",
    "slack",
    "discord"
  ],
  "license": "MIT",
  "dependencies": {
    "infract": "^1.0.3"
  },
  "peerDependencies": {
    "@pulumi/aws": "^6.0.0",
    "@pulumi/pulumi": "^3.0.0",
    "sst": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pulumi/aws": "^6.0.0",
    "@pulumi/pulumi": "^3.0.0",
    "@types/bun": "latest",
    "eslint": "^10.8.0",
    "sst": "^3.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0"
  }
}
